# Compiled binaries from installer
config/hypr/scripts/dots-tui
config/hypr/scripts/dots-tui-*

# Wallust cache / generated output
config/hypr/wallust/*.cache

# Zsh compiled files
home/.zcompdump*

# Version markers from installer
config/hypr/v*

# Hyprland initial boot marker
config/hypr/.initial_startup_done

# Lock screen image cache
config/hypr/hyprlock*.png

# Current-wallpaper state (regenerated by WallpaperSelect.sh / wallust on each change)
config/hypr/wallpaper_effects/.wallpaper_current
config/rofi/.current_wallpaper

# App logs
config/btop/btop.log

# Misc
.DS_Store
*.swp
*.swo
